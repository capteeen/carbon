{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": [], "outputs": [] },
    "typecheck": { "dependsOn": [], "outputs": [] },
    "lint": { "outputs": [] }
  }
}
