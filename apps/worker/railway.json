{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "git submodule update --init && pnpm install --frozen-lockfile"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production pnpm --filter @carbon/worker start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
