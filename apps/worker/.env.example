# @argon/worker (Railway). Names only; set values in the Railway service variables.
NODE_ENV=
PORT=
DATABASE_URL=
REDIS_URL=
ARGON_AGENT_KEY_SEED=
ARGON_PUBLIC_URL=
# LLM (Gemini in production; ANTHROPIC_API_KEY only for the non-production fallback)
GEMINI_API_KEY=
ARGON_LLM_MODEL=
ARGON_LLM_IMAGE_MODEL=
ANTHROPIC_API_KEY=
ARGON_ANTHROPIC_MODEL=
# Development only: "true" allows the non-Gemini fallback. Ignored when NODE_ENV=production
# (the start script and railway.json set it). Default false.
ARGON_LLM_ALLOW_FALLBACK=
# X
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_BEARER_TOKEN=
ARGON_TOKEN_KEY=
# Chain (@argon/solana)
ARGON_NETWORK=
ARGON_MAINNET_ENABLED=
ARGON_RPC_URL=
ARGON_FEE_MODE=
ARGON_VAULT_KEY=
ARGON_BUYBACK_WALLET=
ARGON_TREASURY_WALLET=
ARGON_CRANK_KEY=
ARGON_BUYBACK_KEY=
ARGON_MINT=
ARGON_LOOKUP_TABLE=
ARGON_PRIORITY_FEE_MICROLAMPORTS=
PINATA_JWT=
ARGON_IPFS_GATEWAY=
PUMP_FRONTEND_API_URL=
